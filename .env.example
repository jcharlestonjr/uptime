# Uptime Pro — Environment Variables
# Copy to .env and fill in. Leave optional ones blank to run in mock mode.

# Core
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=change-me-to-a-random-32-char-string

# Database (Neon/Supabase/RDS)
DATABASE_URL=postgresql://user:pass@host:5432/uptime

# Redis (Upstash)
REDIS_URL=redis://localhost:6379/0

# Stripe (billing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_BUSINESS=price_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=alerts@uptimepro.app

# SMS (Twilio) — optional
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# Slack — optional
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Observability — optional
SENTRY_DSN=https://...@sentry.io/...

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=https://uptimepro.app,https://www.uptimepro.app

# Checker
CHECKER_REGIONS=us-east,eu-west,ap-south
CHECKER_CONCURRENCY=50